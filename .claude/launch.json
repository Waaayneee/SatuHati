{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kawteam",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev.mjs"],
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:web"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    }
  ]
}
