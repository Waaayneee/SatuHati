# Database (Supabase session pooler string, driver prefix postgresql+psycopg://)
DATABASE_URL=
# Tests: either a second project's pooler string, or the same string plus TEST_DATABASE_SCHEMA
TEST_DATABASE_URL=
# Optional. When set, tests and `alembic -x target=test` use this isolated schema
TEST_DATABASE_SCHEMA=

# Supabase Auth verification
SUPABASE_URL=
# jwks for projects using asymmetric signing keys, secret for the legacy shared secret
SUPABASE_JWT_MODE=jwks
SUPABASE_JWT_SECRET=

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional. Effort level (low, medium, high, xhigh, max). Blank uses the model default
ANTHROPIC_EFFORT=
# Optional. "default" turns on server-side refusal fallbacks (Claude API only). Blank turns it off
ANTHROPIC_FALLBACKS=

# Agent identity (long random string, used by the orchestrator and later by the MCP server)
AGENT_SERVICE_TOKEN=

# Approval settings
APPROVAL_TTL_HOURS=48
AGENT_MAX_ITERATIONS=8

# Seed users (emails of accounts created in Supabase Auth)
SEED_HOD_EMAIL=
SEED_COMMITTEE_EMAILS=

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Demo only. true lets the UI switch between seeded people without a password
# (X-Profile-Id header). Keep false for anything other people can reach
DEMO_PROFILE_SWITCH=false
